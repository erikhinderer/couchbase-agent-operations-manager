server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse proxy to the operations-manager API so the SPA only ever needs to
    # know about its own origin - see OPERATIONS_MANAGER_UPSTREAM in
    # docker-compose.yml. This file is processed by nginx's docker
    # entrypoint (envsubst over /etc/nginx/templates/*.template) before the
    # container starts, so ${OPERATIONS_MANAGER_UPSTREAM} below is resolved at
    # boot, not at build time.
    location /v1/ {
        proxy_pass http://${OPERATIONS_MANAGER_UPSTREAM}/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    location /api/ {
        proxy_pass http://${OPERATIONS_MANAGER_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        try_files $uri /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json;
}
