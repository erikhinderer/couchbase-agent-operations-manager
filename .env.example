COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=CouchbaseDemo123!
COUCHBASE_BUCKET=agent_operations
COUCHBASE_SCOPE=agent_operations
APPLIANCE_NAME=Couchbase Agent Operations Manager
API_KEY_SUPPORT_AGENT=demo-support-agent-9f21
API_KEY_FINANCE_ANALYST=demo-finance-analyst-7e83
API_KEY_ADMIN=demo-admin-4c56
AUDIT_LOG_RETENTION_HOURS=720
HIJACK_SCAN_INTERVAL_MINUTES=5
HIJACK_CHAIN_WINDOW_SECONDS=120

# --- LLM response caching for agents -----------------------------------
# All three provider keys are optional. A provider with no key still answers
# on a cache miss, from a clearly-labelled offline stub, so the caching
# gateway and its savings dashboard work with no outbound network access.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Bootstrap defaults only - once the appliance has started, the policy is
# edited from the LLM Caching page and stored in Couchbase.
LLM_CACHE_ENABLED=true
LLM_CACHE_PROVIDER=anthropic
LLM_CACHE_MODEL=claude-sonnet-4-5
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ENTRIES=5000
LLM_CACHE_SEMANTIC_ENABLED=true
LLM_CACHE_SIMILARITY_THRESHOLD=0.94
LLM_CACHE_LOG_RETENTION_HOURS=720
